# Exemplo. Copie este arquivo como .env e preencha APENAS no seu computador.
# A mesma chave deve ser salva como secret WHATSAPP_BRIDGE_TOKEN na Cloudflare.
BIGLOGNO_URL=https://biglogno.estoquenovaodessa.workers.dev
WHATSAPP_BRIDGE_TOKEN=
# INATIVO por padrão. Habilite somente após configurar contato e autorização no BigLogno.
WHATSAPP_SEND_ENABLED=false
POLL_INTERVAL_MS=10000
